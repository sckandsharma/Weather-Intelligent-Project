# ==============================================================================
# Weather Intelligence & Advisory Assistant — Environment Configuration
# ==============================================================================

# --- Application ---
APP_NAME="Weather Intelligence Assistant"
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# --- PostgreSQL & pgvector Database ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=weather_db
DB_PORT=5433
DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/weather_db

# --- Redis Caching ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication & RBAC ---
JWT_SECRET_KEY=change_this_to_a_secure_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Large Language Model (Google Gemini) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

# --- Dense Retrieval & Vector Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Open-Meteo Meteorological API ---
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
